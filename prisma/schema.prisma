  equipamento         equipamentos?            @relation(fields: [equipamento_id], references: [id])
  categoria           categorias_equipamentos? @relation(fields: [categoria_id], references: [id])
  plano_origem        planos_manutencao?       @relation("plano_copias", fields: [plano_origem_id], references: [id])
