model instrucoes {
  id               String          @id @default(cuid()) @db.VarChar(26)
  tag              String          @unique @db.VarChar(50)
  nome             String          @db.VarChar(200)
  descricao        String
  categoria        CategoriaTarefa
  tipo_manutencao  TipoManutencao
  condicao_ativo   CondicaoAtivo
  criticidade      Int             @db.SmallInt
  duracao_estimada Decimal         @db.Decimal(5, 2)
  tempo_estimado   Int
  observacoes      String?
  status           StatusTarefa    @default(ATIVA)
  ativo            Boolean         @default(true)
  created_at       DateTime        @default(now()) @db.Timestamp(0)
  updated_at       DateTime        @updatedAt @db.Timestamp(0)
  deleted_at       DateTime?       @db.Timestamp(0)
  criado_por       String?         @db.Char(26)
  atualizado_por   String?         @db.Char(26)

  sub_instrucoes          sub_instrucoes[]
  recursos                recursos_instrucao[]
  anexos                  anexos_instrucao[]
  tarefas                 tarefas[]
  anomalias_instrucoes    anomalias_instrucoes[]
  solicitacoes_instrucoes solicitacoes_instrucoes[]
  usuario_criador         usuarios?                 @relation("instrucoes_criado_por", fields: [criado_por], references: [id])
  usuario_atualizador     usuarios?                 @relation("instrucoes_atualizado_por", fields: [atualizado_por], references: [id])

  @@index([status, ativo])
  @@index([categoria, tipo_manutencao])
  @@index([deleted_at])
}

model sub_instrucoes {
  id             String     @id @default(cuid()) @db.Char(26)
  instrucao_id   String     @db.Char(26)
  descricao      String
  obrigatoria    Boolean    @default(false)
