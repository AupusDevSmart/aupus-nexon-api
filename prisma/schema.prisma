  CONCLUIDA
  FALHOU
}

/// Como a propagacao do template deve tratar a tarefa da copia.
/// HERDADA    - veio do template e ninguem mexeu: a propagacao sobrescreve
/// CUSTOMIZADA - veio do template e foi editada localmente: nao toca
/// REMOVIDA   - veio do template e foi removida localmente: nao ressuscita
