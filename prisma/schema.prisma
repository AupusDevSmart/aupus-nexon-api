/// Ponto logico exposto por um equipamento para integracao com TONs.
/// Cada equipamento com `automacao=true` pode ter N pontos.
/// Tipos: 'comando' (TON dispara), 'status' (TON le bit), 'medicao' (TON le valor analogico).
/// Comando eh o unico tipo operavel hoje; status/medicao ficam preparados.
model equipamento_pontos {
  id             String    @id @default(cuid()) @db.Char(26)
  equipamento_id String    @db.Char(26)
  /// 'comando' | 'status' | 'medicao'
  tipo           String    @db.VarChar(20)
  /// Nome livre do ponto (ex: "abrir", "fechar", "posicao", "corrente_a").
  /// Unico por equipamento.
  nome           String    @db.VarChar(100)
  /// Unidade de medida (so para tipo='medicao'): "A", "V", "kW", "kWh", etc.
  unidade        String?   @db.VarChar(20)
  /// Ordem de exibicao no modal do equipamento.
  ordem          Int       @default(0)
  ativo          Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  updated_at     DateTime  @updatedAt @db.Timestamp(0)
  deleted_at     DateTime? @db.Timestamp(0)

  equipamento equipamentos @relation(fields: [equipamento_id], references: [id], onDelete: Cascade)
  ton_bos     ton_bo[]

  @@unique([equipamento_id, nome])
  @@index([equipamento_id])
  @@index([tipo])
  @@index([ativo])
  @@map("equipamento_pontos")
}

/// Mapeamento Binary Output -> ponto do equipamento alvo.
/// Cada TON3/TON4 tem 6 BOs (bo_numero 1..6 = rele fisico R1..R6).
/// TON1/TON2 nao tem reles — sem linhas para esses TONs.
/// Quando o ponto eh acionado, backend executa pulso: r{N} on -> espera pulso_ms -> r{N} off.
/// ATENCAO: `ton_bi` e `ton_ai` sao da MESMA familia deste modelo — saida,
/// entrada digital e entrada analogica da TON — mas NAO estao neste schema.
/// So `ton_bo` foi modelado, por acidente, e o `migrate diff` trata os irmaos
/// de formas opostas: preserva este e propoe DROPAR os outros dois.
///
/// A lista completa das tabelas fora do schema esta em
/// prisma/TABELAS-FORA-DO-SCHEMA.md. Leia antes de aplicar qualquer diff.
model ton_bo {
  id                   String    @id @default(cuid()) @db.Char(26)
  ton_id               String    @db.Char(26)
  /// Numero do BO (1..6). bo_numero = rele_numero fisico no hardware.
  bo_numero            Int
  /// Ponto do equipamento alvo que esse BO dispara. NULL = BO nao mapeado.
  equipamento_ponto_id String?   @db.Char(26)
  /// Duracao do pulso em ms (r_N on -> wait -> r_N off). Default 500ms.
  pulso_ms             Int       @default(500)
  ativo                Boolean   @default(true)
  created_at           DateTime  @default(now()) @db.Timestamp(0)
  updated_at           DateTime  @updatedAt @db.Timestamp(0)
  deleted_at           DateTime? @db.Timestamp(0)

  ton               equipamentos        @relation(fields: [ton_id], references: [id], onDelete: Cascade)
  equipamento_ponto equipamento_pontos? @relation(fields: [equipamento_ponto_id], references: [id], onDelete: SetNull)

  @@unique([ton_id, bo_numero])
  @@index([ton_id])
  @@index([equipamento_ponto_id])
  @@index([ativo])
  @@map("ton_bo")
}

/// O portao da sincronizacao entre Service e NexOn.
///
/// Nada atravessa a fronteira sem uma linha aqui, criada por um humano. Sem esse
/// portao, um cadastro novo vazaria para o outro produto sem ninguem decidir.
///
/// `versao` e um contador proprio, e NAO um espelho de `updated_at`: os models
/// `plantas` e `usuarios` nao tem `@updatedAt` (as 9 plantas de dev estao com
/// `updated_at` NULL) e as 4 tabelas sao `Timestamp(0)`. Comparar relogio para
/// decidir quem venceu seria comparar nulo com nulo.
///
/// Empate de versao desempata por `origem`, que e igual nos dois lados — assim os
/// dois nos chegam sozinhos a mesma conclusao, sem precisar conversar.
model sincronizacao_vinculos {
  id            BigInt    @id @default(autoincrement())
  recurso       String    @db.VarChar(30)
  registro_id   String    @db.VarChar(26)
  versao        BigInt    @default(0)
  origem        String    @db.VarChar(20)
  hash_conteudo String?   @db.VarChar(64)
  ativo         Boolean   @default(true)
  vinculado_em  DateTime  @default(now()) @db.Timestamp(3)
  vinculado_por String?   @db.VarChar(26)
  atualizado_em DateTime  @default(now()) @db.Timestamp(3)

  @@unique([recurso, registro_id], map: "sincronizacao_vinculos_recurso_registro_key")
}

/// A garantia de entrega.
///
/// A linha e gravada NA MESMA TRANSACAO da escrita do dado. Se o processo morrer
/// entre salvar a planta e avisar o outro lado, o evento ja esta commitado e o
/// worker entrega depois. Publicar por fora da transacao perde evento em queda,
/// e perde calado.
model sincronizacao_outbox {
  id          BigInt    @id @default(autoincrement())
  recurso     String    @db.VarChar(30)
  registro_id String    @db.VarChar(26)
  operacao    String    @db.VarChar(10)
  versao      BigInt
  payload     Json
  criado_em   DateTime  @default(now()) @db.Timestamp(3)
  tentativas  Int       @default(0)
  proxima_em  DateTime  @default(now()) @db.Timestamp(3)
  entregue_em DateTime? @db.Timestamp(3)
  erro        String?

  /// O indice real e PARCIAL (WHERE entregue_em IS NULL) e vive no SQL — o
  /// Prisma nao expressa indice parcial. Sem ele a fila ja entregue, que cresce
  /// para sempre, pesaria na busca do que falta entregar.
  @@index([proxima_em, id], map: "sincronizacao_outbox_pendentes_idx")
}

/// Sem isto ninguem responde "por que o NexOn tem essa planta" nem "quem
/// sobrescreveu minha edicao". Registra tambem o que foi IGNORADO por versao
/// menor, que e o unico rastro que sobra de uma edicao perdida.
model sincronizacao_auditoria {
  id          BigInt    @id @default(autoincrement())
  direcao     String    @db.VarChar(10)
  recurso     String    @db.VarChar(30)
  registro_id String    @db.VarChar(26)
  versao      BigInt?
  origem      String?   @db.VarChar(20)
  resultado   String    @db.VarChar(24)
  detalhe     String?
  ator        String?   @db.VarChar(255)
  criado_em   DateTime  @default(now()) @db.Timestamp(3)

  @@index([recurso, registro_id, criado_em(sort: Desc)], map: "sincronizacao_auditoria_registro_idx")
}
