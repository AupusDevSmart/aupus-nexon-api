/// SIMPLIFICADO: Conexões visuais do diagrama unifilar
/// Versão 2.0 - Apenas dados essenciais (sem customização visual)
/// Todas conexões usam estilo padrão (linha branca/cinza, ortogonal)
model equipamentos_conexoes {
  id                     String              @id @default(cuid()) @db.Char(26)
  diagrama_id            String              @db.Char(26)
  equipamento_origem_id  String?             @db.Char(26)
  /// top, bottom, left, right
  porta_origem           String              @db.VarChar(20)
  equipamento_destino_id String?             @db.Char(26)
  /// top, bottom, left, right
  porta_destino          String              @db.VarChar(20)
  created_at             DateTime            @default(now()) @db.Timestamp(0)
  updated_at             DateTime            @updatedAt @db.Timestamp(0)
  deleted_at             DateTime?           @db.Timestamp(0)
  /// equipamento | junction
  origem_tipo            String?             @default("equipamento") @db.VarChar(20)
  origem_grid_x          Int?
  origem_grid_y          Int?
  /// equipamento | junction
  destino_tipo           String?             @default("equipamento") @db.VarChar(20)
  destino_grid_x         Int?
  destino_grid_y         Int?
  diagrama               diagramas_unitarios @relation(fields: [diagrama_id], references: [id], onDelete: Cascade)
