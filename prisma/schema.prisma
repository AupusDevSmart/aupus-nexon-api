  @@index([equipamento_origem_id])
  @@index([equipamento_destino_id])
  @@index([deleted_at])
  @@index([diagrama_id], map: "idx_conexoes_diagrama_id")
  @@map("equipamentos_conexoes")
}

model anomalias {
  id                   String                 @id @default(cuid()) @db.Char(26)
  /// Numero visivel, no formato ANO-0000, com contagem reiniciando a cada ano.
  ///
  /// Anulavel porque os registros anteriores a este campo nao tem numero, e
  /// atribuir um agora inventaria historico. `@unique` aceita varios nulos no
  /// Postgres, entao a restricao vale so para quem tem numero de fato.
  numero               String?                @unique @db.VarChar(20)
  descricao            String
  local                String                 @db.VarChar(255)
  ativo                String                 @db.VarChar(255)
  data                 DateTime               @default(now()) @db.Timestamp(0)
  condicao             CondicaoAnomalia       @default(FUNCIONANDO)
  origem               OrigemAnomalia
  status               StatusAnomalia         @default(REGISTRADA)
  prioridade           PrioridadeAnomalia     @default(MEDIA)
  observacoes          String?
  criado_por           String?                @db.VarChar(255)
  ordem_servico_id     String?                @db.VarChar(50)
  planta_id            String?                @db.Char(26)
  equipamento_id       String?                @db.Char(26)
  usuario_id           String?                @db.Char(26)
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @updatedAt @db.Timestamp(0)
  deleted_at           DateTime?              @db.Timestamp(0)
  /// Ate quando a anomalia precisa estar resolvida.
  ///
  /// Guia a programacao: e por ele que a lista de origem da OS ordena e sinaliza
  /// o que esta vencido. Sem prazo a anomalia nao cobra nada de ninguem, e era
  /// isso que deixava coisa passar.
  prazo                DateTime?              @db.Timestamp(0)
  observacoes_analise  String?                @map("observacoes_analise")
  analisado_por        String?                @map("analisado_por") @db.VarChar(255)
  data_analise         DateTime?              @map("data_analise") @db.Timestamp(0)
  anexos               anexos_anomalias[]
  equipamento          equipamentos?          @relation(fields: [equipamento_id], references: [id])
  planta               plantas?               @relation(fields: [planta_id], references: [id])
  usuario              usuarios?              @relation("anomalias_usuario", fields: [usuario_id], references: [id])
  historico            historico_anomalias[]
  ordens_servico       ordens_servico[]
  programacoes_os      programacoes_os[]
  anomalias_instrucoes anomalias_instrucoes[]

  @@index([status])
  @@index([prioridade])
  @@index([data])
  @@index([planta_id])
  @@index([equipamento_id])
  @@index([usuario_id])
  @@index([created_at])
  @@index([deleted_at])
  @@map("anomalias")
}

model historico_anomalias {
