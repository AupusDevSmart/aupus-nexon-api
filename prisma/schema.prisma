/// Fila de propagacao do template para as copias.
///
/// Editar um template atinge N equipamentos e cresce sempre, entao a
/// propagacao roda em segundo plano: salvar enfileira, um worker consome. Sincrono
/// funcionaria hoje e estouraria o request no pior momento possivel.
model propagacoes_plano {
  id                  String            @id @default(cuid()) @db.VarChar(26)
  plano_id            String            @db.VarChar(26)
  status              StatusPropagacao  @default(PENDENTE)
  copias_atualizadas  Int               @default(0)
  tarefas_atualizadas Int               @default(0)
  tarefas_criadas     Int               @default(0)
  tarefas_removidas   Int               @default(0)
  /// CUSTOMIZADA/PROPRIA/REMOVIDA que a propagacao respeitou
  tarefas_preservadas Int               @default(0)
  erro                String?
  created_at          DateTime          @default(now()) @db.Timestamp(0)
  iniciado_em         DateTime?         @db.Timestamp(0)
  concluido_em        DateTime?         @db.Timestamp(0)
  plano               planos_manutencao @relation(fields: [plano_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([plano_id])
}

enum StatusPropagacao {
  PENDENTE
