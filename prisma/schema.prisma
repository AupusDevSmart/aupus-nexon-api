model solicitacoes_servico {
  id                        String                   @id @default(cuid())
  numero                    String                   @unique
  titulo                    String
  descricao                 String
  tipo                      TipoSolicitacaoServico
  prioridade                PrioridadeSolicitacao    @default(MEDIA)
  status                    StatusSolicitacaoServico @default(REGISTRADA)
  origem                    OrigemSolicitacao        @default(PORTAL)
  planta_id                 String
  unidade_id                String?
  proprietario_id           String?
  area                      String?
  local_especifico          String?
  equipamento_id            String?
  solicitante_nome          String
  solicitante_email         String?
  solicitante_telefone      String?
  solicitante_departamento  String?
  solicitante_id            String?
  data_necessidade          DateTime?
  prazo_esperado            DateTime?
  data_inicio_previsto      DateTime?
  data_fim_previsto         DateTime?
  tempo_estimado            Decimal?                 @db.Decimal(10, 2)
  custo_estimado            Decimal?                 @db.Decimal(10, 2)
  analisado_por_id          String?
  data_analise              DateTime?
  observacoes_analise       String?
  aprovado_por_id           String?
  data_aprovacao            DateTime?
  observacoes_aprovacao     String?
  rejeitado_por_id          String?
  data_rejeicao             DateTime?
  motivo_rejeicao           String?
  cancelado_por_id          String?
  data_cancelamento         DateTime?
  motivo_cancelamento       String?
  concluido_por_id          String?
  data_conclusao            DateTime?
  observacoes_conclusao     String?
  programacao_os_id         String?
  os_id                     String?
  observacoes               String?
  requisitos_especiais      String?
  riscos_identificados      String?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @default(now()) @updatedAt
  deleted_at                DateTime?
  local                     String                   @db.VarChar(255)
  data_solicitacao          DateTime                 @default(now())
  prazo_execucao            Int?
  data_prevista_inicio      DateTime?
  data_prevista_fim         DateTime?
  justificativa             String?
  beneficios_esperados      String?
  riscos_nao_execucao       String?
  materiais_necessarios     String?
  ferramentas_necessarias   String?
  mao_obra_necessaria       String?
  departamento              String?                  @db.VarChar(100)
  contato                   String?                  @db.VarChar(100)
  analisado_por_nome        String?                  @db.VarChar(255)
  parecer_tecnico           String?
  aprovado_por_nome         String?                  @db.VarChar(255)
  sugestoes_alternativas    String?
  cancelado_por_nome        String?                  @db.VarChar(255)
  ordem_servico_id          String?                  @db.VarChar(50)
  /// ----------------------------------------------------------------------
  /// Proposta comercial — BDI (Benefícios e Despesas Indiretas)
  ///
  /// Os COMPONENTES ficam gravados, e não apenas o percentual resultante.
  /// A proposta segue a formula do acórdão 2.622/2013 do TCU e pode ser
  /// auditada: auditoria pede memória de cálculo, não um número. Se alguém
  /// perguntar por que o BDI deu 30,44%, a resposta tem que estar no registro.
  ///
  ///   I   = PIS + COFINS + CPRB + ISSQN
  ///   BDI = [ (1+AC+SG+R) × (1+DF) × (1+L) / (1-I) ] - 1
  ///
  /// Os padrões abaixo são a tabela GOINFRA sem REIDI, que dá BDI de 30,44%.
  /// Cada solicitação pode ter os seus: regime tributário e natureza do
  /// serviço mudam, e reajustar o padrão amanhã não pode reescrever o que já
  /// foi enviado ao cliente. Pelo mesmo motivo os TOTAIS ficam gravados, e não
  /// recalculados na leitura: o PDF entregue e o número que a lista mostra
  /// precisam ser os mesmos daqui a seis meses.
  ///
  /// O faturamento direto fica FORA da base: o cliente paga o fornecedor, o
  /// dinheiro não passa pela empresa, e entra no total como repasse puro.
  ///
  ///   total_geral = base × (1 + BDI) + custos de faturamento direto
  /// ----------------------------------------------------------------------
  /// SEM_REIDI ou COM_REIDI. O REIDI desonera PIS e COFINS.
  bdi_regime                String                   @default("SEM_REIDI") @db.VarChar(20)
  bdi_administracao_central Decimal?                 @default(5.00) @db.Decimal(6, 3)
  bdi_seguro_garantia       Decimal?                 @default(0.50) @db.Decimal(6, 3)
  bdi_taxa_risco            Decimal?                 @default(0.00) @db.Decimal(6, 3)
  bdi_despesas_financeiras  Decimal?                 @default(0.50) @db.Decimal(6, 3)
  bdi_lucro                 Decimal?                 @default(5.00) @db.Decimal(6, 3)
  bdi_pis                   Decimal?                 @default(0.65) @db.Decimal(6, 3)
  bdi_cofins                Decimal?                 @default(3.00) @db.Decimal(6, 3)
  bdi_cprb                  Decimal?                 @default(4.50) @db.Decimal(6, 3)
  bdi_issqn                 Decimal?                 @default(6.50) @db.Decimal(6, 3)
  /// O resultado da fórmula, gravado para a listagem e o PDF não recalcularem.
  bdi_percentual            Decimal?                 @db.Decimal(6, 3)
  /// Quanto o BDI acrescentou, em reais.
  total_bdi                 Decimal?                 @db.Decimal(14, 2)

  total_custo Decimal? @db.Decimal(14, 2)
  total_geral Decimal? @db.Decimal(14, 2)

  /// OBSOLETOS: substituídos pelo BDI, que já traz lucro (L) e impostos (I).
  /// Ninguém mais lê nem escreve nestas colunas. Ficam porque removê-las exige
  /// migração destrutiva num banco compartilhado com o iot_nexon — e porque
  /// guardam o que as propostas antigas prometeram. Saem numa limpeza dedicada.
  lucro_percentual    Decimal? @default(0) @db.Decimal(5, 2)
  com_nota_fiscal     Boolean  @default(false)
  aliquota_percentual Decimal? @default(15) @db.Decimal(5, 2)
  total_imposto       Decimal? @db.Decimal(14, 2)
  total_lucro         Decimal? @db.Decimal(14, 2)

  anexos                  anexos_solicitacao_servico[]
  comentarios             comentarios_solicitacao_servico[]
  historico               historico_solicitacao_servico[]
  tarefas                 tarefas_solicitacoes[]
  solicitacoes_instrucoes solicitacoes_instrucoes[]
  itens                   solicitacoes_itens[]
  subinstrucoes           solicitacoes_subinstrucoes[]
  outros_custos           solicitacoes_outros_custos[]
  equipamento             equipamentos?                     @relation(fields: [equipamento_id], references: [id])
  planta                  plantas                           @relation(fields: [planta_id], references: [id])
  unidade                 unidades?                         @relation(fields: [unidade_id], references: [id])
  proprietario            usuarios?                         @relation("solicitacoes_proprietario", fields: [proprietario_id], references: [id])
  solicitante             usuarios?                         @relation("solicitacoes_solicitante", fields: [solicitante_id], references: [id])
  programacoes_os         programacoes_os[]

  @@index([status])
  @@index([tipo])
  @@index([planta_id])
  @@map("solicitacoes_servico")
}

/// Copia dos recursos da instrucao, no momento em que ela e vinculada.
///
/// Copia e nao referencia, de proposito. Uma proposta e um documento comercial:
/// se apontasse para o catalogo por id, reajustar o preco de um recurso amanha
/// reescreveria retroativamente uma proposta ja enviada ao cliente. E o mesmo
/// padrao que a OS usa ao congelar os dados da tarefa em tarefas_os.
model solicitacoes_itens {
  id                      String               @id @default(cuid()) @db.VarChar(26)
  solicitacao_id          String
  /// Procedencia, para saber de onde a linha veio. Nao e usado para ler preco.
  instrucao_id            String?              @db.VarChar(26)
  recurso_id              String?              @db.Char(26)
  descricao               String               @db.VarChar(200)
  unidade                 String?              @db.VarChar(20)
  quantidade              Decimal              @default(1) @db.Decimal(10, 3)
  /// O preco que veio do catalogo. Guardado ao lado do editado para a tela
  /// mostrar a variacao sem precisar consultar o catalogo, que pode ter mudado.
  preco_unitario_original Decimal?             @db.Decimal(14, 2)
  preco_unitario          Decimal              @default(0) @db.Decimal(14, 2)
  ordem                   Int                  @default(1) @db.SmallInt
  created_at              DateTime             @default(now()) @db.Timestamp(0)
  updated_at              DateTime             @default(now()) @updatedAt @db.Timestamp(0)
  solicitacao             solicitacoes_servico @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)

  @@index([solicitacao_id])
  @@map("solicitacoes_itens")
}

/// Copia das etapas da instrucao. Entram na proposta como o descritivo do
/// servico; o preco vem dos itens, nao daqui.
model solicitacoes_subinstrucoes {
  id             String               @id @default(cuid()) @db.VarChar(26)
  solicitacao_id String
  instrucao_id   String?              @db.VarChar(26)
