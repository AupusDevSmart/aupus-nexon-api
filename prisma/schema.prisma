// =============================================

model regras_logs_mqtt {
  id               String       @id @default(cuid()) @db.Char(26)
  equipamento_id   String       @db.Char(26)
  nome             String       @db.VarChar(100)
  campo_json       String       @db.VarChar(255)
  operador         String       @db.VarChar(10)
  valor            Decimal      @db.Decimal(15, 4)
  mensagem         String       @db.VarChar(500)
  severidade       String       @default("MEDIA") @db.VarChar(20)
  cooldown_minutos Int          @default(5)
  ativo            Boolean      @default(true)
  created_at       DateTime     @default(now()) @db.Timestamp(0)
  updated_at       DateTime     @updatedAt @db.Timestamp(0)
  deleted_at       DateTime?    @db.Timestamp(0)
  equipamento      equipamentos @relation(fields: [equipamento_id], references: [id], onDelete: Cascade)
  logs             logs_mqtt[]

  @@index([equipamento_id])
  @@index([ativo])
  @@map("regras_logs_mqtt")
}

/// Log polivalente do dominio MQTT — guarda tanto alertas baseados em regra
/// (telemetria que cruza limiar) quanto comandos enviados aos equipamentos.
/// Discriminado pelo campo `tipo`:
///   - 'alerta'  -> usa regra_id, valor_lido, severidade, dados_snapshot
///   - 'comando' -> usa cmd_id, status, latency_ms, usuario_id, ton_id, ton_bo_id,
///                  comando_tecnico, comando_semantico
/// Campos que nao se aplicam ao tipo ficam NULL.
model logs_mqtt {
  id             String   @id @default(cuid()) @db.Char(26)
  /// 'alerta' (telemetria que cruzou regra) | 'comando' (acao enviada via NexOn).
  /// Default 'alerta' por compatibilidade com linhas legadas.
  tipo           String   @default("alerta") @db.VarChar(20)
  /// Equipamento alvo (alerta) OU equipamento controlado pelo comando.
  equipamento_id String   @db.Char(26)
  mensagem       String   @db.VarChar(500)
  /// Severidade: alerta usa 'BAIXA'|'MEDIA'|'ALTA'|'CRITICA'; comando usa 'INFO'|'WARN'|'ERROR'.
  severidade     String   @db.VarChar(20)
  created_at     DateTime @default(now()) @db.Timestamp(0)

  // Campos de alerta (so populados quando tipo='alerta')
  regra_id       String?  @db.Char(26)
  valor_lido     Decimal? @db.Decimal(15, 4)
  dados_snapshot Json?

  // Campos de comando (so populados quando tipo='comando')
  cmd_id            String? @db.VarChar(64)
  status            String? @db.VarChar(20)
  latency_ms        Int?
  usuario_id        String? @db.Char(26)
  ton_id            String? @db.Char(26)
  ton_bo_id         String? @db.Char(26)
  comando_tecnico   String? @db.VarChar(255)
  comando_semantico String? @db.VarChar(255)

  regra       regras_logs_mqtt? @relation(fields: [regra_id], references: [id], onDelete: Cascade)
  equipamento equipamentos      @relation(fields: [equipamento_id], references: [id], onDelete: Cascade)

  @@index([regra_id])
  @@index([equipamento_id])
  @@index([created_at(sort: Desc)])
  @@index([severidade])
  @@index([tipo])
  @@index([cmd_id])
  @@index([ton_id])
  @@map("logs_mqtt")
}

