model tarefas_programacao_os {
  id                   String          @id @default(cuid())
  programacao_id       String          @map("programacao_id")
  tarefa_id            String?         @map("tarefa_id") @db.Char(26)
  ordem                Int             @default(0)
  status               String          @default("PENDENTE") @db.VarChar(20)
  observacoes          String?
  // Congelamento: o que foi pedido no momento da programacao. tarefa_id vira
  // apenas rastro, entao apagar a copia do plano nao destroi o historico.
  nome_snapshot        String?         @map("nome_snapshot") @db.VarChar(200)
  criticidade_snapshot Int?            @map("criticidade_snapshot") @db.SmallInt
  frequencia_snapshot  String?         @map("frequencia_snapshot") @db.VarChar(20)
  instrucao_tag        String?         @map("instrucao_tag") @db.VarChar(50)
  instrucao_nome       String?         @map("instrucao_nome") @db.VarChar(200)
  instrucao_descricao  String?         @map("instrucao_descricao")
  // Congelamento do EQUIPAMENTO. tarefa_id nao serve de caminho estavel ate ele:
  // trocar o plano de um equipamento apaga as copias das tarefas (hard delete
  // deliberado, ver planos-manutencao.service), o FK vira NULL e a OS historica
  // fica orfa. E ordens_servico.equipamento_id quase nunca e preenchido.
  equipamento_id       String?         @map("equipamento_id") @db.Char(26)
  // Data-alvo do ciclo que gerou este item. Base da idempotencia do cron.
  ciclo_referencia     DateTime?       @map("ciclo_referencia") @db.Timestamp(0)
  created_at           DateTime        @default(now()) @map("created_at")
  updated_at           DateTime        @updatedAt @map("updated_at")
  programacao          programacoes_os @relation(fields: [programacao_id], references: [id], onDelete: Cascade)
  tarefa               tarefas?        @relation(fields: [tarefa_id], references: [id])

  @@unique([programacao_id, tarefa_id])
  @@index([programacao_id])
  @@index([tarefa_id])
  @@index([equipamento_id])
  @@map("tarefas_programacao_os")
}

model tarefas_os {
