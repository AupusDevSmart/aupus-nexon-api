  ordem          Int        @db.SmallInt
  created_at     DateTime   @default(now()) @db.Timestamp(0)
  updated_at     DateTime   @updatedAt @db.Timestamp(0)
  instrucao      instrucoes @relation(fields: [instrucao_id], references: [id], onDelete: Cascade)

  @@index([instrucao_id, ordem])
}

/// Catalogo de recursos: o que se usa para executar uma instrucao, com o custo
/// medio que alimenta o orcamento.
///
/// A unidade mora aqui, e nao no uso: tecnico e sempre por hora, cabo e sempre
/// por metro. E ela que torna o preco legivel. A quantidade fica na instrucao,
/// que e onde varia.
model recursos {
  id          String      @id @default(cuid()) @db.Char(26)
  categoria   TipoRecurso
  nome        String      @db.VarChar(200)
  unidade     String?     @db.VarChar(20)
  /// Nulo e diferente de zero: item sem preco aparece como pendencia no
  /// orcamento em vez de entrar na conta como se fosse de graca.
  preco_medio Decimal?    @db.Decimal(12, 2)
  ativo       Boolean     @default(true)
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  updated_at  DateTime    @updatedAt @db.Timestamp(0)
  deleted_at  DateTime?   @db.Timestamp(0)

  usos recursos_instrucao[]

  @@index([categoria])
  @@index([deleted_at])
  @@index([categoria, nome])
}

model recursos_instrucao {
  id           String      @id @default(cuid()) @db.Char(26)
  instrucao_id String      @db.Char(26)
  /// Aponta para o catalogo. Nulo nas linhas antigas, digitadas a mao antes de
  /// o catalogo existir: `tipo` e `descricao` continuam sendo a fonte delas.
  recurso_id   String?     @db.Char(26)
  tipo         TipoRecurso
  descricao    String      @db.VarChar(200)
  quantidade   Decimal?    @db.Decimal(10, 3)
  unidade      String?     @db.VarChar(20)
  obrigatorio  Boolean     @default(false)
  created_at   DateTime    @default(now()) @db.Timestamp(0)
  updated_at   DateTime    @updatedAt @db.Timestamp(0)
  instrucao    instrucoes  @relation(fields: [instrucao_id], references: [id], onDelete: Cascade)
  recurso      recursos?   @relation(fields: [recurso_id], references: [id])

  @@index([instrucao_id, tipo])
  @@index([recurso_id])
}

model anexos_instrucao {
  id           String     @id @default(cuid()) @db.Char(26)
