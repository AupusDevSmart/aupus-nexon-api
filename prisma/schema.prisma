  programacoes_os        programacoes_os[]
  solicitacoes_servico   solicitacoes_servico[]
  tarefas                tarefas[]
  configuracao_custo     configuracoes_custo_equipamento?
  regras_logs_mqtt       regras_logs_mqtt[]
  logs_mqtt              logs_mqtt[]
